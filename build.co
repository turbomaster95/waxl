package waxl 0.1.0

script sysroot/gen.c "bash ../scripts/mkmusl.sh && touch sysroot/gen.c"

set CC "${CC:-gcc}"
set CFLAGS "-Wall -Wextra -O2 -std=gnu23 -fPIC -D_GNU_SOURCE -nostdinc -nostdlib -isystem $PWD/build/sysroot/include -D__user= -ffreestanding"
set LDFLAGS "-B$PWD/build/sysroot/lib -L$PWD/build/sysroot/lib -Wl,-dynamic-linker=/lib/ld-musl-x86_64.so.1 -rdynamic -lc -static-libgcc"

# pls remember to update .clangd when updating this line
INCLUDES -I../include/ -I../lib/nu/include -I. -I../lib/lidrm -Isysroot/include/luajit-2.1 -I../lib/common

script sysroot/lib/libluajit.a "../scripts/mkluajit.sh"
order sysroot/gen.c

script ../lib/nu/build/libnu.a "cd ../lib/nu && ../../reconf/reconf build.co && ./configure && ninja -C build"
order sysroot/gen.c

script .gen1 "mkdir -p user/recovery"

target_a waxl-lidrm.a
sources \
        lib/lidrm/lidrm.c
order sysroot/gen.c

target_a waxl-common.a
sources \
	lib/common/log.c
order sysroot/gen.c

target_bin waxl-init
sources \
        core/waxl-init.c
deps ../lib/nu/build/libnu.a waxl-common.a
order sysroot/gen.c

target_bin waxl-incubator
sources \
        core/waxl-incubator.c
deps sysroot/lib/libluajit.a waxl-common.a
order sysroot/gen.c

target_bin waxl-exec
sources \
        core/waxl-exec.c
deps ../lib/nu/build/libnu.a
order sysroot/gen.c

target_bin oomkd
sources \
        sys/oomkd.c
order sysroot/gen.c

target_bin waxl-comp
sources \
        sys/compositor/waxl-comp.c
deps ../lib/nu/build/libnu.a waxl-lidrm.a
order sysroot/gen.c

target_bin test-comp
sources \
        sys/compositor/test-comp.c
order sysroot/gen.c

target_so hello.so
sources \
        apps/hello/main.c
order sysroot/gen.c

script hello.wax "mkdir -p staging/lib && cp ../apps/hello/WAX-MANIFEST staging/ && cp hello.so staging/lib/app.so && tar -cf hello.wax -C staging WAX-MANIFEST lib/app.so && rm -rf staging"
deps hello.so 
order sysroot/gen.c
